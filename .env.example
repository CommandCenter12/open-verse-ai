# Open Verse Ai: backend configuration (Cloudflare Worker)
# Never commit real values. Local dev: copy to worker/.dev.vars
# Production: `npx wrangler secret put IP_SALT`

# SECRET: random string used to hash client IPs for key-creation rate limits.
# Generate with: openssl rand -hex 32
IP_SALT=replace-with-64-hex-chars

# Non-secret vars live in worker/wrangler.toml [vars]:
#   ALLOWED_ORIGINS   comma-separated origins allowed by CORS
#   RATE_PER_MINUTE   /v1/ask requests per key per minute   (default 20)
#   QUOTA_PER_DAY     /v1/ask requests per key per UTC day  (default 500)
#   KEYS_PER_IP_DAY   new keys per IP per UTC day          (wrangler.toml: 20)
